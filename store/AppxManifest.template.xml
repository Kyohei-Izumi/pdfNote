<?xml version="1.0" encoding="utf-8"?>
<!--
  pdfNote's MSIX manifest. build_msix.ps1 fills the {{...}} values from
  identity.json (the values Partner Center shows under Product identity) and
  writes the finished AppxManifest.xml into the package layout.

  The app is an ordinary Windows program (a PyInstaller .exe), so it declares
  the full-trust entry point and the runFullTrust capability, which is what
  Microsoft Learn's "Package a desktop app manually" describes.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{IDENTITY_PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{RESERVED_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 1809 is the oldest release that still gets
         security updates and is the minimum pdfNote supports. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- One tag per language, not per country (6.4): "ar" is listed for every
       Arabic speaker, where "ar-SA" was Saudi Arabia's alone. Portuguese has
       no such tag in the Store: "pt-BR" is Brazil's and "pt" Portugal's (and
       the other countries that write as Portugal does). Latin, Ancient Greek
       and Sanskrit, which pdfNote also speaks, are not languages the Store
       takes, so they are not declared. The first is the default language.
       Kept the same as STORE_LANGUAGE_TAGS in app.py. -->
  <Resources>
    <Resource Language="ja" />
    <Resource Language="en" />
    <Resource Language="zh-Hans" />
    <Resource Language="ko" />
    <Resource Language="es" />
    <Resource Language="fr" />
    <Resource Language="ru" />
    <Resource Language="ar" />
    <Resource Language="de" />
    <Resource Language="pt-BR" />
    <Resource Language="pt" />
    <Resource Language="hi" />
    <Resource Language="bn" />
    <Resource Language="ur" />
  </Resources>

  <Applications>
    <Application Id="pdfNote" Executable="pdfNote.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{RESERVED_NAME}}"
        Description="{{SHORT_DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- pdfNote already opens the file named on its command line
             (main() takes a "pdf" argument), which is how Windows hands a
             double-clicked file to a full-trust packaged app. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The OCR language data download (6.5): the only connection pdfNote
         opens itself, after the user agrees. Declared so the Store page
         says the app uses the internet. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
