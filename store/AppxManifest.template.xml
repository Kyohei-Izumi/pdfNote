<?xml version="1.0" encoding="utf-8"?>
<!--
  pdfNote's MSIX manifest. build_msix.ps1 fills the {{...}} values from
  identity.json (the values Partner Center shows under Product identity) and
  writes the finished AppxManifest.xml into the package layout.

  The app is an ordinary Windows program (a PyInstaller .exe), so it declares
  the full-trust entry point and the runFullTrust capability, which is what
  Microsoft Learn's "Package a desktop app manually" describes.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{IDENTITY_PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{RESERVED_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 1809 is the oldest release that still gets
         security updates and is the minimum pdfNote supports. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
    <Resource Language="zh-Hans-CN" />
    <Resource Language="ko-KR" />
    <Resource Language="es-ES" />
    <Resource Language="fr-FR" />
    <Resource Language="ru-RU" />
    <Resource Language="ar-SA" />
  </Resources>

  <Applications>
    <Application Id="pdfNote" Executable="pdfNote.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{RESERVED_NAME}}"
        Description="{{SHORT_DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- pdfNote already opens the file named on its command line
             (main() takes a "pdf" argument), which is how Windows hands a
             double-clicked file to a full-trust packaged app. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
